# Bookinistic Studio .gitignore

# ==========================================
# 1. Секреты и ключи доступа (КРИТИЧНО)
# ==========================================
.gemini_api_key
.yandex_s3_credentials
.ozon_credentials
.env
*.env
*.pem
*.key

# ==========================================
# 2. Исполняемые бинарные файлы
# ==========================================
cloudflared
*.exe
*.dll
*.dylib
*.so

# ==========================================
# 3. База данных SQLite и WAL-файлы
# ==========================================
*.db
*.db-shm
*.db-wal
storage/catalog.db*
storage/backups/
storage/archive/

# ==========================================
# 4. Временные сессии и тяжелые черновики
# ==========================================
storage/session_draft.json
storage/card.png

# ==========================================
# 5. Пользовательские фото и медиа-хранилище
# ==========================================
storage/inbox/*
!storage/inbox/.gitkeep

storage/books_vault/*
!storage/books_vault/.gitkeep

books/test_raw/*
!books/test_raw/.gitkeep

scratch/*
!scratch/.gitkeep

# ==========================================
# 6. Сформированные таблицы выгрузки Ozon
# (Шаблоны в templates/ остаются в Git!)
# ==========================================
ready_tables/*.xlsx
ready_tables/backups/*
!ready_tables/.gitkeep
!ready_tables/backups/.gitkeep
/Печатная книга_*.xlsx
!templates/*.xlsx
~$*

# ==========================================
# 7. Логи сервера
# ==========================================
*.log
server.log

# ==========================================
# 8. Python кэш и виртуальные окружения
# ==========================================
__pycache__/
*.py[cod]
*$py.class
env/
venv/
.venv/

# ==========================================
# 9. Системные файлы macOS и IDE
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.idea/
