# =================================================================
# Bookinistic Studio — Единый файл конфигурации окружения (.env)
# =================================================================
# Скопируйте этот файл в .env и укажите ваши ключи:
# cp .env.example .env
#
# Подробная инструкция по получению ключей: docs/KEYS_GUIDE.md
# =================================================================

# Порт локального веб-сервера студии (по умолчанию 8095)
PORT=8095

# -----------------------------------------------------------------
# 1. Google Gemini AI API (ОБЯЗАТЕЛЬНО для работы ИИ)
# Получить бесплатный ключ: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourSecretGeminiApiKeyHere

# -----------------------------------------------------------------
# 2. Ozon Seller API (Опционально: для синхронизации каталога и брендов)
# Получить в ЛК Ozon Seller -> Настройки -> API ключи (тип: Товары)
# -----------------------------------------------------------------
OZON_CLIENT_ID=1234567
OZON_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# -----------------------------------------------------------------
# 3. Yandex Object Storage / S3 CDN (Опционально: публичные ссылки на фото)
# Получить в консоли Yandex Cloud -> Object Storage
# -----------------------------------------------------------------
S3_BUCKET=your-book-bucket-name
S3_KEY_ID=YCAJExxxxxxxxxxxxxxx
S3_SECRET_KEY=YCPxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION_NAME=ru-central1
